# Optional local demo persistence override. No external service is required.
# MEANINGFULMEET_DATA_FILE=/absolute/path/to/demo.json
# Optional Omi and Gemini integrations require the configuration below.
# Optional separate Find Twin demo persistence override.
# MEANINGFULMEET_LOCATION_DATA_FILE=/absolute/path/to/find-twin.json

# Optional private Fieldnotes generation. Set an available Gemini text model ID.
# GEMINI_API_KEY=
# OMI_MAGAZINE_MODEL=

# Existing omi-branch audio bridge. Server connects to /listen-ws?mode=captions.
# The bridge keeps ingesting Omi audio and running speech-to-text independently.
# OMI_BRIDGE_URL=http://127.0.0.1:8787
# Only this account may read this device's captions. No browser microphone is used.
# OMI_BRIDGE_OWNER_USER_ID=usr_self
